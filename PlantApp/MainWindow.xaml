<Window x:Class="PlantApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Рослини" Height="560" Width="440">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Margin" Value="0,5,5,0"/>
            <Setter Property="Padding" Value="10,4"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="0,2,0,5"/>
        </Style>
    </Window.Resources>
    <StackPanel Margin="10">
        <TextBlock Text="Вид рослини"/>
        <ComboBox x:Name="KindBox" SelectedIndex="0" SelectionChanged="KindBox_SelectionChanged" Margin="0,2,0,5">
            <ComboBoxItem Content="Дерево"/>
            <ComboBoxItem Content="Квітка"/>
        </ComboBox>

        <TextBlock Text="Назва"/>
        <TextBox x:Name="NameBox"/>

        <TextBlock Text="Тип"/>
        <TextBox x:Name="TypeBox"/>

        <TextBlock Text="Місце вирощування"/>
        <TextBox x:Name="PlaceBox"/>

        <TextBlock x:Name="ExtraLabel" Text="Вік"/>
        <TextBox x:Name="ExtraBox"/>

        <StackPanel Orientation="Horizontal">
            <Button Content="Додати" Click="Add_Click"/>
            <Button Content="Полити" Click="Water_Click"/>
            <Button Content="Посадити" Click="PlantIt_Click"/>
        </StackPanel>

        <ListBox x:Name="PlantList" Height="180" Margin="0,10,0,0"/>

        <TextBlock x:Name="AverageText" Text="Середній вік дерев: 0" Margin="0,10,0,0" FontWeight="Bold"/>
    </StackPanel>
</Window>
